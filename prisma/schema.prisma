generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  TEACHER
  DEPARTMENT
}

enum Visibility {
  GLOBAL
  RESTRICTED
}

enum ActionType {
  VIEW
  DOWNLOAD
}

enum MaterialStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String
  role            Role      @default(TEACHER)
  isActive        Boolean   @default(true)
  departmentId    String?
  department      User?     @relation("TeacherDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  teachers        User[]    @relation("TeacherDepartment")
  description     String?
  driveFolderId   String?
  phone           String?
  telegram        String?
  supportContacts Json      @default("[]")
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Xavfsizlik: Brute-force himoyasi
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  materialsCreated  Material[]           @relation("MaterialCreatedBy")
  materialsUploaded Material[]           @relation("MaterialUploadedBy")
  materialsReviewed Material[]           @relation("MaterialReviewedBy")
  assignedMaterials MaterialAssignment[]
  activities        MaterialActivity[]
  driveActivities   DriveActivity[]

  departmentResources Resource[] @relation("ResourceDepartments")
  teacherResources    Resource[] @relation("ResourceTeachers")

  bookmarks         Bookmark[]
  personalResources PersonalResource[]

  @@index([role])
  @@index([departmentId])
  @@index([isActive])
}

model PersonalResource {
  id          String   @id @default(cuid())
  title       String
  url         String
  type        String // "video" yoki "link"
  category    String?
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([type])
  @@index([category])
}

model Bookmark {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String

  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model Resource {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        String
  url         String
  category    String
  visibility  Visibility @default(GLOBAL)

  departments User[] @relation("ResourceDepartments")
  teachers    User[] @relation("ResourceTeachers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([visibility])
}

model Material {
  id          String     @id @default(cuid())
  title       String
  description String?
  subject     String
  format      String // e.g. "PDF", "Video", "Document", "Presentation"
  driveFileId String
  visibility  Visibility @default(GLOBAL)

  // Moderatsiya maydonlari
  status MaterialStatus @default(APPROVED)

  // Kim yaratgan (Admin)
  createdById String
  createdBy   User   @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // Kim yuklagan (O'qituvchi yoki Kafedra o'zi yuklasa)
  uploadedById String?
  uploadedBy   User?   @relation("MaterialUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  // Rad etish sababi
  rejectionReason String?

  // Kim tekshirgan (Super Admin)
  reviewedById String?
  reviewedBy   User?     @relation("MaterialReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments MaterialAssignment[]
  activities  MaterialActivity[]

  @@index([createdById])
  @@index([uploadedById])
  @@index([reviewedById])
  @@index([status])
  @@index([visibility])
  @@index([subject])
  @@index([format])
}

model MaterialAssignment {
  id         String @id @default(cuid())
  materialId String
  teacherId  String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  teacher  User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([materialId, teacherId])
  @@index([materialId])
  @@index([teacherId])
}

model MaterialActivity {
  id         String     @id @default(cuid())
  materialId String
  teacherId  String?
  actionType ActionType
  createdAt  DateTime   @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  teacher  User?    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([teacherId])
  @@index([actionType])
}

model LibraryBook {
  id              String   @id @default(cuid())
  title           String
  author          String?
  coverImage      String?
  driveUrl        String
  category        String?
  publicationYear Int?
  pageCount       Int?
  annotation      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([title])
  @@index([author])
  @@index([category])
}

model DriveActivity {
  id          String     @id @default(cuid())
  driveFileId String
  actionType  ActionType
  userId      String?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([driveFileId])
  @@index([userId])
}
